# Copy to .env and fill in. .env is in .gitignore: never commit it.
PORT=3100
NODE_ENV=development
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# ---- Microsoft 365 sign-in (Entra ID) ----
# Entra admin centre > App registrations > New registration (single tenant). Add a "Web" redirect URI that matches
# ENTRA_REDIRECT_URI exactly, then Certificates & secrets > New client secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3100/auth/callback
# Who may enter (must also be in the tenant). Comma separated.
OPS_ALLOWED_DOMAIN=optimumgroup.co.za
# OPS_ALLOWED_EMAILS=someone@other-domain.com

# ---- ClickUp ----
CLICKUP_TEAM_ID=90152653226
CLICKUP_SPACE_ID=901511610772
# Option A (simplest): a personal API token (ClickUp > avatar > Settings > Apps > API Token)
CLICKUP_API_TOKEN=
# Option B: OAuth app (https://developer.clickup.com/docs/authentication). Register the redirect URI in ClickUp, then
# open the dashboard and press "Connect ClickUp" once. The token is saved in data/clickup-token.json.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3100/ops/clickup/callback

# Optional
# OPS_ADMIN_EMAILS=marc@optimumgroup.co.za     (only these people may press Connect ClickUp)
# OPS_REFRESH_SECONDS=300                      (browser auto-refresh)
# CLICKUP_CACHE_SECONDS=60                     (server cache, keeps ClickUp rate limits safe)
